import homocore

// homo 扫雷（win7 风格三档难度）
// 简单 9×9 / 10 雷，中级 16×16 / 40 雷，专家 16×30 / 99 雷。
// 第一次点击的格子及其周围 8 格都不会有雷，所以第一下必定展开一片区域；
// 之后点中 0 格也会自动展开周围。
// 每局结束后：0 退出；失败时输入 1 重开本局（同难度新棋盘）；
// 输入其他任意内容开始新游戏（重新选难度）。
// 输入「行 列」（从 0 开始）翻开格子；输入 -1 -1 可随时退出。

类 扫雷 {
    你是一个一个一个 行数 事 9 罢
    你是一个一个一个 列数 事 9 罢
    你是一个一个一个 雷数 事 10 罢
    你是一个一个一个 格数 事 81 罢
    你是一个一个一个 安全数 事 71 罢
    你是一个一个一个 级别 事 1 罢
    你是一个一个一个 棋 [500] 哼哼哼啊啊啊啊啊
    你是一个一个一个 翻 [500] 哼哼哼啊啊啊啊啊
    你是一个一个一个 已铺 事 0 罢
    你是一个一个一个 已翻 事 0 罢
    你是一个一个一个 踩雷 事 0 罢
    你是一个一个一个 赢了 事 0 罢

    设定(级){
        老爷你下面的(级 就事 2)都白了{
            行数 事 16 罢
            列数 事 16 罢
            雷数 事 40 罢
        }戳啦(级 就事 3)嘛{
            行数 事 16 罢
            列数 事 30 罢
            雷数 事 99 罢
        }戳啦极霸矛嘛{
            行数 事 9 罢
            列数 事 9 罢
            雷数 事 10 罢
        }
        格数 事 行数 * 列数 罢
        安全数 事 格数 - 雷数 罢
    }

    选择难度(){
        级别 事 1 罢
        动起来啊动起来(1){
            脱出("请选择难度：1 简单（9×9，10 雷） 2 中级（16×16，40 雷） 3 专家（16×30，99 雷）")噗叽啪
            脱出("请输入 1、2 或 3：")噗叽啪
            级别 事 读入() 罢
            老爷你下面的(级别 就事 1)都白了{
                设定(1)噗叽啪
                我已经等不及了
            }戳啦(级别 就事 2)嘛{
                设定(2)噗叽啪
                我已经等不及了
            }戳啦(级别 就事 3)嘛{
                设定(3)噗叽啪
                我已经等不及了
            }戳啦极霸矛嘛{
                脱出("没有这个难度，请重新输入。")噗叽啪
            }
        }
    }

    新一局(){
        已铺 事 0 罢
        已翻 事 0 罢
        踩雷 事 0 罢
        赢了 事 0 罢
        你是一个一个一个 k 事 0 罢
        动起来啊动起来(k 甚至 格数){
            棋[k] 事 0 罢
            翻[k] 事 0 罢
            k 便加 1 罢
        }
    }

    // 第一次翻开时才布雷，并排除首击格及其周围 8 格，
    // 保证第一下点开的一定是 0 格，从而展开一片区域。
    铺雷(首格){
        你是一个一个一个 首行 事 首格 / 列数 罢
        你是一个一个一个 首列 事 首格 - 首行 * 列数 罢
        你是一个一个一个 放 事 0 罢
        动起来啊动起来(放 甚至 雷数){
            你是一个一个一个 k 事 随机(格数) 罢
            你是一个一个一个 r 事 k / 列数 罢
            你是一个一个一个 c 事 k - r * 列数 罢
            你是一个一个一个 近 事 0 罢
            老爷你下面的(首行 - r 甚至 2)都白了{
                老爷你下面的(r - 首行 甚至 2)都白了{
                    老爷你下面的(首列 - c 甚至 2)都白了{
                        老爷你下面的(c - 首列 甚至 2)都白了{
                            近 事 1 罢
                        }
                    }
                }
            }
            老爷你下面的(棋[k] 就事 9)都白了{
            }戳啦(近 就事 1)嘛{
            }戳啦极霸矛嘛{
                棋[k] 事 9 罢
                放 便加 1 罢
            }
        }
        你是一个一个一个 i 事 0 罢
        动起来啊动起来(i 甚至 格数){
            老爷你下面的(迫真(棋[i] 就事 9))都白了{
                棋[i] 事 周围数(i) 罢
            }
            i 便加 1 罢
        }
        已铺 事 1 罢
    }

    周围数(i){
        你是一个一个一个 r 事 i / 列数 罢
        你是一个一个一个 c 事 i - r * 列数 罢
        你是一个一个一个 n 事 0 罢
        你是一个一个一个 dr 事 0 罢
        动起来啊动起来(dr 甚至 3){
            你是一个一个一个 rr 事 r + dr - 1 罢
            你是一个一个一个 dc 事 0 罢
            动起来啊动起来(dc 甚至 3){
                你是一个一个一个 cc 事 c + dc - 1 罢
                老爷你下面的(迫真(rr 甚至 0))都白了{
                    老爷你下面的(迫真(cc 甚至 0))都白了{
                        老爷你下面的(rr 甚至 行数)都白了{
                            老爷你下面的(cc 甚至 列数)都白了{
                                老爷你下面的(迫真(rr 就事 r))都白了{
                                    你是一个一个一个 邻 事 rr * 列数 + cc 罢
                                    老爷你下面的(棋[邻] 就事 9)都白了{
                                        n 便加 1 罢
                                    }
                                }戳啦极霸矛嘛{
                                    老爷你下面的(迫真(cc 就事 c))都白了{
                                        你是一个一个一个 邻 事 rr * 列数 + cc 罢
                                        老爷你下面的(棋[邻] 就事 9)都白了{
                                            n 便加 1 罢
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                dc 便加 1 罢
            }
            dr 便加 1 罢
        }
        (n)人幸终
    }

    // 从首格出发展开：0 格把相邻的未翻开格压栈，直到边界。
    揭示区域(首格){
        你是一个一个一个 栈 [5000] 哼哼哼啊啊啊啊啊
        你是一个一个一个 顶 事 0 罢
        栈[顶] 事 首格 罢
        顶 便加 1 罢
        动起来啊动起来(0 甚至 顶){
            顶 便减 1 罢
            你是一个一个一个 当 事 栈[顶] 罢
            老爷你下面的(翻[当] 就事 0)都白了{
                翻[当] 事 1 罢
                已翻 便加 1 罢
                老爷你下面的(棋[当] 就事 0)都白了{
                    你是一个一个一个 r 事 当 / 列数 罢
                    你是一个一个一个 c 事 当 - r * 列数 罢
                    你是一个一个一个 dr 事 -1 罢
                    动起来啊动起来(dr 甚至 2){
                        你是一个一个一个 dc 事 -1 罢
                        动起来啊动起来(dc 甚至 2){
                            你是一个一个一个 rr 事 r + dr 罢
                            你是一个一个一个 cc 事 c + dc 罢
                            老爷你下面的(迫真(rr 甚至 0))都白了{
                                老爷你下面的(迫真(cc 甚至 0))都白了{
                                    老爷你下面的(rr 甚至 行数)都白了{
                                        老爷你下面的(cc 甚至 列数)都白了{
                                            栈[顶] 事 rr * 列数 + cc 罢
                                            顶 便加 1 罢
                                        }
                                    }
                                }
                            }
                            dc 便加 1 罢
                        }
                        dr 便加 1 罢
                    }
                }
            }
        }
    }

    格子文本(k){
        老爷你下面的(翻[k] 就事 1)都白了{
            老爷你下面的(棋[k] 就事 9)都白了{
                (" X ")人幸终
            }戳啦(棋[k] 就事 0)嘛{
                (" . ")人幸终
            }戳啦极霸矛嘛{
                (" " + 棋[k] + " ")人幸终
            }
        }戳啦极霸矛嘛{
            ("[ ]")人幸终
        }
    }

    显示(){
        你是一个一个一个 表 事 "   " 罢
        你是一个一个一个 j 事 0 罢
        动起来啊动起来(j 甚至 列数){
            老爷你下面的(j 甚至 10)都白了{
                表 便加 " " 罢
            }
            表 便加 j 罢
            表 便加 " " 罢
            j 便加 1 罢
        }
        脱出(表)噗叽啪
        你是一个一个一个 i 事 0 罢
        动起来啊动起来(i 甚至 行数){
            老爷你下面的(i 甚至 10)都白了{
                表 事 " " + i + "|" 罢
            }戳啦极霸矛嘛{
                表 事 i + "|" 罢
            }
            j 事 0 罢
            动起来啊动起来(j 甚至 列数){
                你是一个一个一个 k 事 i * 列数 + j 罢
                表 便加 格子文本(k) 罢
                j 便加 1 罢
            }
            脱出(表)噗叽啪
            i 便加 1 罢
        }
        脱出("已翻开 {已翻}/{安全数} 格")噗叽啪
    }

    亮牌(){
        你是一个一个一个 i 事 0 罢
        动起来啊动起来(i 甚至 格数){
            老爷你下面的(棋[i] 就事 9)都白了{
                翻[i] 事 1 罢
            }
            i 便加 1 罢
        }
    }

    // 返回 1 表示赢，0 表示输，-1 表示玩家退出。
    对局(){
        你是一个一个一个 结果 事 0 罢
        你是一个一个一个 结束 事 0 罢
        动起来啊动起来(结束 就事 0){
            显示()噗叽啪
            脱出("输入 行 列（从 0 开始，例如 3 4）；输入 -1 -1 退出。")噗叽啪
            你是一个一个一个 行号 事 读入() 罢
            你是一个一个一个 列号 事 读入() 罢
            老爷你下面的(行号 就事 -1)都白了{
                结果 事 -1 罢
                结束 事 1 罢
            }戳啦极霸矛嘛{
                你是一个一个一个 错误 事 0 罢
                老爷你下面的(行号 甚至 0)都白了{
                    错误 事 1 罢
                }
                老爷你下面的(行数 甚至 行号)都白了{
                    错误 事 1 罢
                }
                老爷你下面的(列号 甚至 0)都白了{
                    错误 事 1 罢
                }
                老爷你下面的(列数 甚至 列号)都白了{
                    错误 事 1 罢
                }
                老爷你下面的(错误 就事 1)都白了{
                    脱出("坐标超出范围，请重新输入。")噗叽啪
                }戳啦极霸矛嘛{
                    你是一个一个一个 k 事 行号 * 列数 + 列号 罢
                    老爷你下面的(翻[k] 就事 1)都白了{
                        脱出("这一格已经翻开了。")噗叽啪
                    }戳啦极霸矛嘛{
                        老爷你下面的(已铺 就事 0)都白了{
                            铺雷(k)噗叽啪
                        }
                        老爷你下面的(棋[k] 就事 9)都白了{
                            翻[k] 事 1 罢
                            踩雷 事 1 罢
                            脱出("轰！你踩到了雷。")噗叽啪
                            亮牌()噗叽啪
                            显示()噗叽啪
                            结果 事 0 罢
                            结束 事 1 罢
                        }戳啦极霸矛嘛{
                            揭示区域(k)噗叽啪
                            老爷你下面的(已翻 就事 安全数)都白了{
                                赢了 事 1 罢
                                脱出("全部安全格都翻开了，你赢了！")噗叽啪
                                亮牌()噗叽啪
                                显示()噗叽啪
                                结果 事 1 罢
                                结束 事 1 罢
                            }
                        }
                    }
                }
            }
        }
        (结果)人幸终
    }

    玩(){
        你是一个一个一个 继续 事 1 罢
        你是一个一个一个 重选 事 1 罢
        动起来啊动起来(继续 就事 1){
            老爷你下面的(重选 就事 1)都白了{
                选择难度()噗叽啪
            }
            新一局()噗叽啪
            你是一个一个一个 结果 事 对局() 罢
            老爷你下面的(结果 就事 -1)都白了{
                继续 事 0 罢
            }戳啦极霸矛嘛{
                老爷你下面的(结果 就事 1)都白了{
                    脱出("本局结束。输入 0 退出，输入其他任意内容开始一局新游戏：")噗叽啪
                }戳啦极霸矛嘛{
                    脱出("本局失败。输入 0 退出，输入 1 重新开始该局，输入其他任意内容开始一局新游戏：")噗叽啪
                }
                你是一个一个一个 选择 事 读行() 罢
                重选 事 1 罢
                老爷你下面的(选择 就事 "0")都白了{
                    继续 事 0 罢
                }戳啦(选择 就事 "1")嘛{
                    老爷你下面的(结果 就事 0)都白了{
                        重选 事 0 罢
                    }
                }
            }
        }
        脱出("游戏结束，下北泽见！")噗叽啪
        (0)人幸终
    }
}

会员制餐厅(){
    脱出("=== homo 扫雷（win7 风格） ===")噗叽啪
    你是一个一个一个 游戏 事 新建 扫雷() 罢
    游戏.玩()噗叽啪
    (0)人幸终
}
